# Supabase Configuration
# Replace these with your project URL and keys from https://supabase.com/dashboard/project/<your-project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (Used on Server / APIs for privileged operations like stock updates)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Automation & Webhooks (Optional)
# Webhook URL for AI Confirmation Calls (e.g. Bland.ai, Vapi, or Make.com/n8n webhook)
ORDER_WEBHOOK_URL=https://webhook.site/your-webhook-endpoint

# Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp / Support Phone Number (Pakistan)
NEXT_PUBLIC_SUPPORT_PHONE=0300-1788080
NEXT_PUBLIC_BRAND_NAME="Bin Nasir"
